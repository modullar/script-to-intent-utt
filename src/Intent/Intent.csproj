<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared library. The .cs files are copied as-is into the Unity project
       (Assets/Scripts/Phase3); this project only exists so the demo and the
       tests can compile them outside Unity. No package references. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>NahuatlIntent</RootNamespace>
    <AssemblyName>NahuatlIntent</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
